{
  "name": "novatv",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "NovaTV — 参考 DecoTV UI + TVBox 播放原理的前后端综合视频平台",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "mock": "node fixtures/mock-cms.js",
    "validate": "node scripts/validate.mjs",
    "sidecar:jvm": "node scripts/jvm-sidecar.mjs",
    "sidecar:jvm:build": "node scripts/jvm-sidecar.mjs --build",
    "oss:list": "node scripts/oss-spider.mjs --list",
    "oss:build": "node scripts/oss-spider.mjs",
    "oss:verify": "node scripts/oss-spider.mjs --verify",
    "probe:js": "node scripts/js-rt-probe.mjs",
    "android:libs": "node scripts/extract-spider-libs.mjs --config \"http://www.饭太硬.cc/tv\"",
    "android:preflight": "bash sidecar/android/preflight.sh",
    "docker:preflight": "node scripts/docker-preflight.mjs",
    "docker:build": "docker build -t novatv:local . && docker build -f Dockerfile.sidecar -t novatv-sidecar:local .",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f"
  }
}
