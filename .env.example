# ============================================================================
# NovaTV 环境变量
#
#   cp .env.example .env
#   然后按下面注释改 3 个地方：PUID/PGID、SPIDER_TOKEN、（可选）CONFIG_URL
#
# 配合 docker-compose.nas.yml 使用时，侧车按需启用：
#   docker compose -f docker-compose.nas.yml up -d                              # 只要主服务
#   docker compose -f docker-compose.nas.yml --profile jvm up -d                # + JVM 侧车
#   docker compose -f docker-compose.nas.yml --profile jvm --profile android up -d  # 全都要
# ============================================================================

# GHCR 账号名必须小写。本地构建时这一项无关紧要
GHCR_OWNER=0uzu0

# 镜像标签：latest / v1.2.0 / sha-abc1234 都行
NOVATV_TAG=latest

# 宿主机端口（浏览器访问用的就是这个）
NOVATV_PORT=8890

# ---------------------------------------------------------------------------
# 数据目录属主 —— 必改，填错会导致网页能开但搜不出结果（写不进 ./data）
#
#   查法（在 NAS 的 SSH 里）：  id 你的用户名
#     → uid=1026(xxx) gid=100(users)    就填 PUID=1026  PGID=100
#
#   群晖首个用户通常是 1026:100，威联通/飞牛常见 1000:1000
# ---------------------------------------------------------------------------
PUID=1000
PGID=1000

TZ=Asia/Shanghai

# 接口地址。域名里的中文可以直接写，Docker 内部会用 punycode 解析
CONFIG_URL=http://www.饭太硬.cc/tv

# 可选：额外配置聚合（逗号分隔多个 URL）
CONFIG_URLS=

# ---------------------------------------------------------------------------
# 侧车口令 —— 只要用侧车就必设，随便一串字母数字，两侧车共用
#   不设 = 侧车接口无鉴权，等于把「能执行任意 spider 代码」的服务敞在内网
#
#   生成一个：  openssl rand -hex 16
# ---------------------------------------------------------------------------
SPIDER_TOKEN=

# ---------------------------------------------------------------------------
# JVM 侧车（跑未加固的 spider jar）
# 启用条件：--profile jvm，且下面这行不能空
#
# 同一 compose 网络内用服务名，别写 127.0.0.1（那是容器自己）
# ---------------------------------------------------------------------------
# SPIDER_JVM_URL=http://novatv-sidecar:8899

# ---------------------------------------------------------------------------
# Android 侧车（跑加固包 csp_*Guard）
#
# 启用条件：--profile android，且这台机器有 /dev/kvm
#
# 填哪个地址，取决于侧车跑在哪：
#
#   A) 侧车是本机的 Docker 容器（QEMU 模拟器，最常见）
#      用宿主别名 —— 模拟器在 NAT 后面，容器只能通过宿主转发过去
#      SPIDER_ANDROID_URL=http://host.docker.internal:8899
#
#   B) 侧车是局域网里的手机 / TV 盒子
#      手机上点「启动侧车」后屏幕会直接显示地址，照抄即可
#      SPIDER_ANDROID_URL=http://192.168.1.23:8899
#
#   填完先自测：curl "http://<地址>/health?token=$SPIDER_TOKEN"
# ---------------------------------------------------------------------------
# SPIDER_ANDROID_URL=http://host.docker.internal:8899
