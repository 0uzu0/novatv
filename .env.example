# GHCR 账号名必须小写。本地构建（docker compose up -d --build）时这一项无关紧要
GHCR_OWNER=0uzu0

# 镜像标签：latest / v1.2.0 / sha-abc1234 都行
NOVATV_TAG=latest

# 宿主机端口
NOVATV_PORT=8890

# 数据目录属主。群晖默认首个用户是 1026，威联通常见 1000
PUID=1000
PGID=1000

TZ=Asia/Shanghai

# 接口地址。域名里的中文可以直接写，Docker 内部会用 punycode 解析
CONFIG_URL=http://www.饭太硬.cc/tv

# 可选：额外配置聚合（逗号分隔多个 URL）
CONFIG_URLS=

# --- Android 侧车（手机 / TV 盒子 / redroid）---
# 手机上点「启动侧车」后，屏幕会直接显示这两行的值
# SPIDER_ANDROID_URL=http://192.168.1.23:8899
# SPIDER_TOKEN=your-token

# --- JVM 侧车（未加固 jar，一般不用开）---
# SPIDER_JVM_URL=http://novatv-sidecar:8899
