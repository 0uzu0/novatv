# 运行期产物，不入库（容器里由卷挂载出来）
# 保留目录本身，否则 git clone 后 docker 会以 root 身份创建 data/，导致容器内写不进去
data/*
!data/.gitkeep
reports/*.json
sidecar/jvm/build/

# 本地环境
.env
.env.local
node_modules/
*.log
.DS_Store
Thumbs.db

# 加固包的 native 库由 scripts/extract-spider-libs.mjs 现场生成（第三方壳二进制，不入库）
# 需要预置时：node scripts/extract-spider-libs.mjs --config "http://www.饭太硬.cc/tv"
sidecar/android/host-apk/app/src/main/jniLibs/*/
# APK 构建产物
sidecar/android/host-apk/app/build/
sidecar/android/host-apk/.gradle/
sidecar/android/host-apk/build/
sidecar/android/host-apk/local.properties

# 开源 spider 构建中间产物
# refs 是 CatVodSpider 的 git clone（脚本 ensureRepo 会自己拉），src/classes 是导出与编译结果，
# stubs 是编译期桩的 .class。只有 stubs-src 是手写的，要入库。
tools/openspider/refs/
tools/openspider/src/
tools/openspider/classes/
tools/openspider/stubs/

# 开源 spider 的第三方依赖 jar：由 scripts/oss-spider.mjs 按需下载（okhttp/jsoup/zxing/nanohttpd…）
sidecar/jvm/libs/*.jar

# 本地构建的 APK（CI 会重新出包）
dist/*.apk
